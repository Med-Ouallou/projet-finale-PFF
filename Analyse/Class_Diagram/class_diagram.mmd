classDiagram
    %% Spatie Roles & Permissions Integration
    class Role {
        +int id
        +string name
        +string guard_name
    }

    class Permission {
        +int id
        +string name
        +string guard_name
    }

    class User {
        +int id
        +string name
        +string email
        +string password
        +timestamp email_verified_at
        +assignRole(Role role)
        +givePermissionTo(Permission permission)
        +hasRole(string role) bool
        +hasPermissionTo(string permission) bool
    }

    User "1" -- "*" Role : has many
    Role "*" -- "*" Permission : has many
    User "*" -- "*" Permission : has direct permissions

    %% Menu et Produits
    class Menu {
        +int id
        +string name
    }

    class Category {
        +int id
        +string name
    }

    class MenuItem {
        +int id
        +string name
        +string description
        +float price
        +string status
        +updateAvailability()
    }

    Menu "1" *-- "*" Category
    Category "1" *-- "*" MenuItem

    %% Commandes
    class Order {
        +int id
        +datetime date
        +float totalAmount
        +string status
        +calculateTotal()
    }

    class OrderItem {
        +int quantity
        +float subtotal
    }

    User "1" -- "*" Order : places / handles
    Order "1" *-- "*" OrderItem
    OrderItem "*" -- "1" MenuItem : contains

    %% Rapports
    class Report {
        +int id
        +string type
        +datetime dateRange
        +string content
        +generate()
    }

    User "1" -- "*" Report : views


