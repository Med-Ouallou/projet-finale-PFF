classDiagram
direction LR

class Role {
  int id
  string name
  string guard_name
}

class Permission {
  int id
  string name
  string guard_name
}

class User {
  int id
  string name
  string email
  string password
  timestamp email_verified_at
  assignRole(role)
  givePermissionTo(permission)
  hasRole(role)
  hasPermissionTo(permission)
}

User "1" --> "*" Role : has roles
Role "*" --> "*" Permission : has permissions
User "*" --> "*" Permission : direct permissions

class Menu {
  int id
  string name
}

class Category {
  int id
  string name
}

class MenuItem {
  int id
  string name
  string description
  float price
  string status
  updateAvailability()
}

Menu "1" --> "*" Category
Category "1" --> "*" MenuItem

class Order {
  int id
  datetime date
  float totalAmount
  string status
  calculateTotal()
}

class OrderItem {
  int quantity
  float subtotal
}

User "1" --> "*" Order : places
Order "1" --> "*" OrderItem
OrderItem "*" --> "1" MenuItem : contains

class Report {
  int id
  string type
  datetime dateRange
  string content
  generate()
}

User "1" --> "*" Report : views