@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

' ===== STYLE =====
skinparam backgroundColor #FFFFFF
skinparam usecase {
    BackgroundColor #F7F7F7
    BorderColor #333333
    ArrowColor #333333
}
skinparam actor {
    BorderColor #000000
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #666666
}

' ===== COMPACT LAYOUT =====
skinparam nodesep 15
skinparam ranksep 20
skinparam padding 3
skinparam packagePadding 5
skinparam usecasePadding 5
skinparam wrapWidth 120

' ===== ACTORS =====
actor "Admin" as Admin
actor "Employee" as Employee
actor "Customer" as Customer

' ===== SYSTEM =====
rectangle "Sprint 2: Advanced Features" {

    package "Admin Analytics & Inventory" {
        usecase "View Revenue Reports" as UA5
        usecase "Manage Inventory" as UA6
        usecase "Manage Promotions" as UA7
        usecase "Check Low Stock" as UA6INC
    }

    package "Staff Operations" {
        usecase "Update Order Status" as UE2
    }

    package "Order Management" {
        usecase "Place Order" as UC2
        usecase "Order via WhatsApp" as UC2WA
        usecase "Calculate Total" as UC2CALC
        usecase "Apply Promotion" as UC2PROMO
    }

    package "Account Management" {
        usecase "Track Orders" as UC3
        usecase "Manage Profile" as UC4
        usecase "View Order History" as UC5
    }

    ' ── Relationships ──
    UA6 ..> UA6INC : <<include>>
    UC2 ..> UC2CALC : <<include>>
    UC2WA ..> UC2 : <<extend>>
    UC2PROMO ..> UC2 : <<extend>>
}

' ===== ACTOR CONNECTIONS =====
Admin -- UA5
Admin -- UA6
Admin -- UA7

Employee -- UE2

Customer -- UC2
Customer -- UC3
Customer -- UC4
Customer -- UC5

@enduml
