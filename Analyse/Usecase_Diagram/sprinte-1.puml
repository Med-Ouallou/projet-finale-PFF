@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

' ===== STYLE =====
skinparam backgroundColor #FFFFFF
skinparam usecase {
    BackgroundColor #F7F7F7
    BorderColor #333333
    ArrowColor #333333
}
skinparam actor {
    BorderColor #000000
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #666666
}

' ===== COMPACT LAYOUT =====
skinparam nodesep 15
skinparam ranksep 20
skinparam padding 3
skinparam packagePadding 5
skinparam usecasePadding 5
skinparam wrapWidth 120

' ===== ACTORS =====
actor "Admin" as Admin
actor "Employee" as Employee
actor "Customer" as Customer

' ===== SYSTEM =====
rectangle "Sprint 1: Restaurant Management System" {

    package "Admin Management" {
        usecase "Manage Users" as UA1
        usecase "Manage Menus" as UA2
        usecase "Manage Categories" as UA3
        usecase "View Dashboard" as UA4
    }

    package "Staff Operations" {
        usecase "View Orders" as UE1
        usecase "Manage Menu Items" as UE3
        usecase "View Personal Statistics" as UE4
    }

    package "Customer Portal" {
        usecase "Browse Menu" as UC1
        usecase "Filter by Category" as UC1EXT
        usecase "Contact Restaurant" as UC6
        
        usecase "Place Order" as UC2
        usecase "Order via WhatsApp" as UC2WA
        usecase "Calculate Total" as UC2CALC
    }

    ' ── Relationships ──
    UC1EXT ..> UC1 : <<extend>>
    UC2 ..> UC2CALC : <<include>>
    UC2WA ..> UC2 : <<extend>>
}

' ===== ACTOR CONNECTIONS =====
Admin -- UA1
Admin -- UA2
Admin -- UA3
Admin -- UA4

Employee -- UE1
Employee -- UE3
Employee -- UE4

Customer -- UC1
Customer -- UC6
Customer -- UC2

@enduml
