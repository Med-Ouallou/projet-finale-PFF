@startuml
top to bottom direction
skinparam packageStyle rectangle

actor Admin
actor Employer
actor Customer

rectangle "Mini Restaurant Management System - Sprint 2" {

    (Authentication)

    ' Sprint 2 use cases
    Admin -- (View Reports & Statistics)
    Admin -- (Manage Inventory)

    Employer -- (Manage Menu Items)
    Employer -- (Update Order Status) 

    Customer -- (Track Orders)
    Customer -- (Apply Promotions)

    ' include relationships
    (View Reports & Statistics) .. (Authentication) : <<include>>
    (Manage Inventory) .. (Authentication) : <<include>>
    (Manage Menu Items) .. (Authentication) : <<include>>
    (Update Order Status) .. (Authentication) : <<include>>
    (Track Orders) .. (Authentication) : <<include>>
    (Apply Promotions) .. (Authentication) : <<include>>
}
@enduml